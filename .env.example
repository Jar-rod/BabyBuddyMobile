# Copy to .env (install-pi.sh writes it for you on the Pi). Quote values with '…'
# so characters like $ and # stay literal.
# Where Baby Buddy runs (from inside Docker on the Pi, the LAN IP works).
BABYBUDDY_URL='http://192.168.0.28:8000'
# Either an API key (Baby Buddy → user menu → API key) …
BABYBUDDY_TOKEN=
# … or a username/password the server logs in with to fetch the key.
BABYBUDDY_USER='Ramsaroop'
BABYBUDDY_PASSWORD=''
# Port phones use (the container listens on 8090 inside).
HOST_PORT=8001
